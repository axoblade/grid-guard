rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Transformer Validation
    function isValidTransformer(data) {
      return data.keys().hasAll(['id', 'name', 'serialNumber', 'phoneNumber', 'registrationLocation', 'status']) &&
             data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             data.serialNumber is string && data.serialNumber.size() <= 100 &&
             data.phoneNumber is string && data.phoneNumber.size() <= 20 &&
             data.status in ['GREEN', 'ORANGE', 'RED', 'UNKNOWN'] &&
             data.registrationLocation.latitude is number &&
             data.registrationLocation.longitude is number;
    }

    match /transformers/{transformerId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // In a locked-down app, we would restrict by ownerId
      
      allow create: if isSignedIn() && 
                    isValidId(transformerId) && 
                    isValidTransformer(incoming()) &&
                    incoming().id == transformerId;

      allow update: if isSignedIn() && 
                    isValidTransformer(incoming()) && (
                      // Action: Heartbeat/Update Location/Status
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'currentLocation', 'status', 'riskRating', 'riskAnalysis', 'simSwapHistory'
                      ]) ||
                      // Action: Maintenance/Admin update (if allowed)
                      incoming().diff(existing()).affectedKeys().hasOnly([
                        'maintenanceSchedule', 'alertPhoneNumbers'
                      ])
                    ) &&
                    incoming().id == existing().id &&
                    incoming().serialNumber == existing().serialNumber; // Immutable
    }

    match /alerts/{alertId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn(); // Ideally only from a trusted service, but client writes for now in Demo
    }
  }
}
